# Copy this file to .env and fill in real values. Never commit .env.

# Elasticsearch — pick ONE option.
# Local (start-local): password is in elastic-start-local/.env -> ES_LOCAL_PASSWORD
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=
# Elastic Cloud: set ES_URL to your deployment's Elasticsearch endpoint and fill ES_API_KEY.
# When ES_API_KEY is set it is used instead of ES_USER/ES_PASSWORD.
ES_API_KEY=

# RAG assistant: id of an Elasticsearch inference endpoint (completion task).
# Create it once in Kibana Dev Tools — see README "LLM setup". Its API key lives in Elasticsearch.
LLM_INFERENCE_ID=openai-completion

# Optional: pin "now" for demos (Overview tab: happening now / up next / side events today)
# e.g. DEMO_NOW=2026-11-10T13:45:00-07:00 — leave empty to use the real clock
DEMO_NOW=

# Optional: voice questions in the Assistant tab (speech-to-text via OpenAI)
OPENAI_API_KEY=
