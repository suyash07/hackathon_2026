# Copy this file to .env and fill in real values. Never commit .env.

# Elasticsearch (password is in elastic-start-local/.env -> ES_LOCAL_PASSWORD)
ES_URL=http://localhost:9200
ES_USER=elastic
ES_PASSWORD=

# LLM for the RAG assistant (get a key at console.anthropic.com)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
